# ===== Auth.js (admin panel session) =====
AUTH_SECRET=  # openssl rand -base64 32

# ===== App database (Settings / OwnHcode / AdminWhitelist / LoginLog) =====
APP_DATABASE_URL=mysql://app_user:app_pass@127.0.0.1:3306/hotspot_app

# ===== daloRADIUS / FreeRADIUS database (radcheck / radreply / radusergroup) =====
RADIUS_DATABASE_URL=mysql://radius:radius_pass@127.0.0.1:3306/radius

# ===== Health ID (moph.id.th) =====
HEALTH_CLIENT_ID=
HEALTH_CLIENT_SECRET=
# ต้องลงทะเบียน redirect_uri ทั้ง 3 ตัวนี้กับ moph.id.th (แยกกันเพราะคนละ flow)
HEALTH_REDIRECT_URI=https://your-domain.example.com/api/auth/healthid
PROVIDER_REDIRECT_URI=https://your-domain.example.com/api/auth/providerid
ADMIN_REDIRECT_URI=https://your-domain.example.com/api/auth/admin-providerid

# ===== Provider ID (provider.id.th) =====
PROVIDER_CLIENT_ID=
PROVIDER_CLIENT_SECRET=
